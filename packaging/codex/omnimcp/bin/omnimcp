#!/bin/sh
# Codex plugin shim for an externally installed omniMCP runtime.
# The portable Agent Plugins format permits a bare name or plugin-local path.
set -eu

plugin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
self=$(readlink -f -- "$0" 2>/dev/null || printf '%s/%s' "$plugin_dir" "$(basename -- "$0")")

if [ -n "${OMNIMCP_BIN:-}" ]; then
    runtime=$OMNIMCP_BIN
else
    runtime=$(command -v omnimcp || true)
fi

if [ -z "$runtime" ] || [ ! -x "$runtime" ]; then
    echo "omnimcp plugin: install omniMCP or set OMNIMCP_BIN to its executable" >&2
    exit 127
fi

resolved=$(readlink -f -- "$runtime" 2>/dev/null || printf '%s' "$runtime")
if [ "$resolved" = "$self" ]; then
    echo "omnimcp plugin: OMNIMCP_BIN/PATH resolves to this plugin shim" >&2
    exit 127
fi

# Keep the desktop session that launched this process available to the server.
export WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
exec "$runtime" "$@"
