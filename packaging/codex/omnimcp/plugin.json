{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "omnimcp",
  "version": "0.2.1",
  "description": "Local omnimcp tools and desktop workflow for Codex.",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "omnimcp",
        "shortDescription": "Control your Linux desktop",
        "longDescription": "Use the existing omnimcp server and its workflow skill to inspect and operate the local Hyprland desktop, Canvas files, and the configured Kanban board.",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "defaultPrompt": [
          "Inspect my desktop with omnimcp."
        ],
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg"
      }
    }
  }
}
